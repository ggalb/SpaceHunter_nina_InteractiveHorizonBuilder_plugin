<ResourceDictionary
    x:Class="InteractiveHorizonBuilder.DockableTemplate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:InteractiveHorizonBuilder">

    <!--  Naming convention required by N.I.N.A.: "<Fully.Qualified.VMTypeName>_Dockable"  -->
    <DataTemplate x:Key="InteractiveHorizonBuilder.HorizonBuilderDockableVM_Dockable">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,4"
                FontSize="16"
                FontWeight="Bold"
                Text="Interactive Horizon Builder" />

            <StackPanel Grid.Row="1" Margin="0,0,0,8" Orientation="Horizontal">
                <TextBlock Foreground="Gray" Text="Mount " />
                <TextBlock Foreground="Gray" Text="{Binding MountConnected}" />
                <TextBlock Foreground="Gray" Text="  ·  Az " />
                <TextBlock Foreground="Gray" Text="{Binding MountAzimuth, StringFormat=F1}" />
                <TextBlock Foreground="Gray" Text="°  Alt " />
                <TextBlock Foreground="Gray" Text="{Binding MountAltitude, StringFormat=F1}" />
                <TextBlock Foreground="Gray" Text="°  ·  Horizon@Az " />
                <TextBlock Foreground="Gray" Text="{Binding HorizonAltitudeAtMount, StringFormat=F1}" />
                <TextBlock Foreground="Gray" Text="°" />
            </StackPanel>

            <Viewbox
                Grid.Row="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Stretch="Uniform">
                <local:SkyDomeView
                    Width="460"
                    Height="460"
                    CrosshairAltitude="{Binding TargetAltitude}"
                    CrosshairAzimuth="{Binding TargetAzimuth}"
                    Horizon="{Binding Model}"
                    MountAltitude="{Binding MountAltitude}"
                    MountAzimuth="{Binding MountAzimuth}"
                    PointPickedCommand="{Binding PointPickedCommand}"
                    RedrawTrigger="{Binding EditVersion}"
                    SelectedIndex="{Binding SelectedIndex}" />
            </Viewbox>

            <local:StripView
                Grid.Row="3"
                Margin="0,8,0,0"
                CrosshairAltitude="{Binding TargetAltitude}"
                CrosshairAzimuth="{Binding TargetAzimuth}"
                Horizon="{Binding Model}"
                MountAltitude="{Binding MountAltitude}"
                MountAzimuth="{Binding MountAzimuth}"
                PointPickedCommand="{Binding PointPickedCommand}"
                RedrawTrigger="{Binding EditVersion}"
                SelectedIndex="{Binding SelectedIndex}" />

            <StackPanel Grid.Row="4" Margin="0,10,0,0" Orientation="Vertical">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Target  Az" />
                    <TextBox Width="60" Margin="4,0,10,0" Text="{Binding TargetAzimuth, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="Alt" />
                    <TextBox Width="60" Margin="4,0,10,0" Text="{Binding TargetAltitude, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock VerticalAlignment="Center" Text="Step" />
                    <TextBox Width="44" Margin="4,0,10,0" Text="{Binding NudgeStep, StringFormat=F1, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Margin="0,0,4,0" Padding="6,2" Command="{Binding AzMinusCommand}" Content="Az −" />
                    <Button Margin="0,0,10,0" Padding="6,2" Command="{Binding AzPlusCommand}" Content="Az +" />
                    <Button Margin="0,0,4,0" Padding="6,2" Command="{Binding AltMinusCommand}" Content="Alt −" />
                    <Button Margin="0,0,10,0" Padding="6,2" Command="{Binding AltPlusCommand}" Content="Alt +" />
                    <Button Margin="0,0,6,0" Padding="8,2" Command="{Binding TargetToMountCommand}" Content="= mount" ToolTip="Copy the current mount Az/Alt into the target/crosshair" />
                    <Button Margin="0,0,6,0" Padding="10,2" Command="{Binding SlewCommand}" Content="Slew" />
                    <Button Margin="0,0,6,0" Padding="10,2" Command="{Binding StopCommand}" Content="STOP" />
                    <Button Margin="0,0,6,0" Padding="8,2" Command="{Binding TrackingOnCommand}" Content="Track on" />
                    <Button Margin="0,0,6,0" Padding="8,2" Command="{Binding TrackingOffCommand}" Content="Track off" />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Foreground="Gray" Text="{Binding MountStatus, StringFormat='Mount: {0}'}" />
            </StackPanel>

            <StackPanel Grid.Row="5" Margin="0,8,0,0" Orientation="Vertical">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="Edit horizon:  " />
                    <Button Margin="0,0,6,0" Padding="10,2" Command="{Binding PlaceConfirmCommand}" Content="Place / Confirm" ToolTip="Add a point at the crosshair, or update the selected point to the crosshair" />
                    <Button Margin="0,0,6,0" Padding="10,2" Command="{Binding DeleteCommand}" Content="Delete" IsEnabled="{Binding HasSelection}" />
                    <Button Margin="0,0,6,0" Padding="10,2" Command="{Binding UndoCommand}" Content="Undo" />
                    <Button Margin="0,0,6,0" Padding="12,2" Command="{Binding SaveCommand}" Content="Save" ToolTip="Write the .hrz and reload it into N.I.N.A." />
                </WrapPanel>
                <TextBlock Margin="0,6,0,0" Foreground="#ED9F27" Text="{Binding EditStatus, StringFormat='Edit: {0}'}" />
            </StackPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
