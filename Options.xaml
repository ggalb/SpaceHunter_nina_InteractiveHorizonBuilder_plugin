<ResourceDictionary
    x:Class="InteractiveHorizonBuilder.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Naming convention required by N.I.N.A.: "<AssemblyTitle>_Options"  -->
    <DataTemplate x:Key="Interactive Horizon Builder_Options">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Orientation="Vertical">
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="This plugin has no settings here - all controls live on its panel. Open it from the Imaging tab, the same way you call other plug-ins." />
            <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" FontStyle="Italic"
                       Text="Full instructions are in the Description below." />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
