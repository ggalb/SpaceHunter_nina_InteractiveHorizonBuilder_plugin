<ResourceDictionary
    x:Class="InteractiveHorizonBuilder.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Naming convention required by N.I.N.A.: "<AssemblyTitle>_Options"  -->
    <DataTemplate x:Key="Interactive Horizon Builder_Options">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Orientation="Vertical">
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                       Text="All controls live on the plugin's panel. Open it from the Imaging tab, the same way you call other plug-ins." />
            <TextBlock Margin="0,0,0,4" FontWeight="Bold" Text="Stellarium export" />
            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Horizon line colour (R,G,B, each 0-1):  " />
                <TextBox Width="120" Text="{Binding StellariumLineColor, UpdateSourceTrigger=LostFocus}" />
            </StackPanel>
            <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Foreground="Gray"
                       Text="Default .55,.55,.10 (olive). Examples: 1,0,0 red - 0,1,0 green - 1,1,0 yellow. Used by the panel's Stellarium... button; re-export and re-install the landscape to see a change." />
            <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" FontStyle="Italic"
                       Text="Full instructions are in the Description below." />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
